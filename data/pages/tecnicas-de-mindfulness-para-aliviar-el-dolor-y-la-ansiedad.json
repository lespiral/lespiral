      "html": "Practicaremos"
     },
     {
      "t": "text",
      "html": "<ul>\n<li data-section-id=\"12kop8g\" data-start=\"2281\" data-end=\"2312\">\n<p data-start=\"2283\" data-end=\"2312\">Anclajes corporales simples</p>\n</li>\n<li data-section-id=\"7xvyxy\" data-start=\"2313\" data-end=\"2352\">\n<p data-start=\"2315\" data-end=\"2352\">Respiración reguladora (sin forzar)</p>\n</li>\n<li data-section-id=\"1jgoibc\" data-start=\"2353\" data-end=\"2384\">\n<p data-start=\"2355\" data-end=\"2384\">Escáner corporal respetuoso</p>\n</li>\n<li data-section-id=\"tq6o7z\" data-start=\"2385\" data-end=\"2424\">\n<p data-start=\"2387\" data-end=\"2424\">Diferenciar sensación y pensamiento</p>\n</li>\n<li data-section-id=\"xcpqk3\" data-start=\"2425\" data-end=\"2459\">\n<p data-start=\"2427\" data-end=\"2459\">Atravesar la ansiedad sin huir</p>\n</li>\n<li data-section-id=\"to3cfo\" data-start=\"2460\" data-end=\"2501\">\n<p data-start=\"2462\" data-end=\"2501\">Reducir la tensión interna automática</p>\n</li>\n<li data-section-id=\"1k8l1k3\" data-start=\"2502\" data-end=\"2528\">\n<p data-start=\"2504\" data-end=\"2528\">Autocompasión aplicada</p>\n</li>\n</ul>"
     }
